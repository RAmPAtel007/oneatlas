# Postgres connection string.
#   Local:      postgresql://postgres:postgres@localhost:5433/oneatlas   (npm run db:local)
#   Production: your Neon pooled connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Bearer token required by /api/cron/ingest (Vercel Cron sends it automatically).
CRON_SECRET="replace-with-a-long-random-string"
